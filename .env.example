PORT=3000
DATABASE_URL="postgresql://postgres:CHANGE_ME@postgres-host:5432/postgres"
JWT_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_EXPIRES_IN="8h"
TENANT_BASE_DOMAIN="tusaas.com"
RESTAURANT_PUBLIC_BASE_URL="https://core.tusaas.com"

# Runtime SaaS / rolling deploy
DIAN_EMBEDDED_WORKER_ENABLED="true"
NOTIFICATION_EMBEDDED_WORKER_ENABLED="true"
RESTAURANT_SCHEMA_STARTUP_RETRY_MS="3000"
RESTAURANT_SCHEMA_STARTUP_MAX_ATTEMPTS="12"
# Coolify puede inyectar SOURCE_COMMIT; no fijarlo manualmente.
