# P13-A/B1 · laboratorio local aislado
VANTIX_P13_LAB_ENABLED=true
P13_HOST=127.0.0.1
P13_PORT=8790
P13_MUTATIONS_ENABLED=false

# Identidad single-tenant del laboratorio.
P13_TENANT_SUBDOMAIN=demo-restaurante
# Generar un secreto aleatorio exclusivo del laboratorio, mínimo 32 caracteres.
P13_JWT_SECRET=replace-with-a-random-lab-only-secret-at-least-32-chars
# Contraseña temporal para el ADMIN local de P13-B1; no reutilizar credenciales reales.
P13_ADMIN_PASSWORD=replace-with-a-strong-lab-only-password

# PostgreSQL exclusivo del laboratorio. No usar 5432 ni una base de producción.
P13_POSTGRES_PASSWORD=change-me-p13-only
DATABASE_URL=postgresql://vantix_p13:change-me-p13-only@127.0.0.1:55432/vantix_p13_lab

# El runtime P13 no levanta workers ni registra tenants.
DIAN_EMBEDDED_WORKER_ENABLED=false
NOTIFICATION_EMBEDDED_WORKER_ENABLED=false
DISABLE_RESTAURANT_DEMO_BOOTSTRAP=true
PUBLIC_TENANT_REGISTRATION_ENABLED=false
