# P14 Home Pilot · NO usar en un restaurante real todavía
RESTAURANT_LOCAL_FIRST_P14_ENABLED="true"
P14_RUNTIME_ENABLED="true"

# Contrato fijo del piloto
P14_TENANT_SUBDOMAIN="demo-restaurante"
P14_INSTALLATION_ID="HOME-PILOT-01"
P14_RELEASE_CHANNEL="PILOT"
P14_OPERATIONAL_MODE="LOCAL_FIRST"

# Runtime local aislado
P14_HTTP_PORT="8790"
P14_LAN_ENABLED="false"
P14_BIND_HOST="127.0.0.1"
P14_ADVERTISE_HOST="127.0.0.1"
P14_LAN_CIDR=""

# PostgreSQL local dedicado
DATABASE_URL="postgresql://vantix_p14:CHANGE_ME@127.0.0.1:55432/vantix_p14_home_pilot"

# Secretos exclusivos de esta instalación; no reutilizar los de Core ni Edge 8788
P14_JWT_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
P14_ADMIN_PASSWORD="CHANGE_ME_12_CHARS_MINIMUM"

# Super Core permanece online, pero la sincronización se habilitará únicamente en P14-3
P14_CORE_URL="https://core.vantixgc.com"
P14_SYNC_ENABLED="false"

# Para probar desde tablets en la LAN, cambiar únicamente después de reservar una IP en el router:
# P14_LAN_ENABLED="true"
# P14_BIND_HOST="0.0.0.0"
# P14_ADVERTISE_HOST="192.168.1.50"
# P14_LAN_CIDR="192.168.1.0/24"
